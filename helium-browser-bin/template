# Template file for 'helium-browser-bin'
pkgname=helium-browser-bin
version=0.17.0.1
revision=1
_realname="helium"
archs="x86_64"
short_desc="Private, fast, and honest web browser based on ungoogled-chromium"
maintainer="YuG <https://codeberg.org/YuG>"
license="GPL-3.0-only, BSD-3-Clause"
homepage="https://github.com/imputnet/helium-linux"

distfiles="https://github.com/imputnet/helium-linux/releases/download/${version}/${_realname}-${version}-x86_64_linux.tar.xz"
checksum="50238835e8896253d4af142a3032354119c1e6f7e777926c4530195c714ff3f5"

wrksrc="${_realname}-${version}-x86_64_linux"

#depends="gtk+3 nss alsa-lib xdg-utils libXScrnSaver libcups libgcrypt
# liberation-fonts-ttf dbus libpulseaudio pciutils libva libffi
# desktop-file-utils hicolor-icon-theme"

nostrip=yes

do_install() {
    local target_dir="usr/lib/helium-browser"

    vmkdir "${target_dir}"
    cp -a ${wrksrc}/. "${DESTDIR}/${target_dir}/"

    vinstall "${FILESDIR}/helium-wrapper" 755 "${target_dir}"

    rm -f "${DESTDIR}/${target_dir}/helium.desktop"
    rm -f "${DESTDIR}/${target_dir}/product_logo_256.png"

    vsed -i "${wrksrc}/helium.desktop" \
        -e 's|^Name=Helium|Name=Helium Browser|' \
        -e 's|^Exec=helium|Exec=helium-browser|' \
        -e 's|^Icon=helium|Icon=helium-browser|'

    vinstall "${wrksrc}/helium.desktop" 644 usr/share/applications helium.desktop

    vmkdir usr/bin
    ln -sf "/${target_dir}/helium-wrapper" "${DESTDIR}/usr/bin/helium-browser"

    vinstall "${wrksrc}/product_logo_256.png" 644 \
        usr/share/icons/hicolor/256x256/apps helium-browser.png

    vinstall "${wrksrc}/product_logo_256.png" 644 \
        usr/share/pixmaps helium-browser.png

    vlicense "${FILESDIR}/LICENSE.ungoogled_chromium"
}
