pkgname=dmemcg-booster-nk
version=0.1.2
revision=1
create_wrksrc=yes
hostmakedepends="cargo git"
short_desc="Valve's dmemcg-booster port without systemd/dbus dependencies"
maintainer="JavierC"
license="GPL-3.0-or-later" # Cámbiala a MIT u otra si el repo usa una distinta
homepage="https://github.com/Neko-Void-Linux/dmemcg-booster-nk"

do_build() {
	git clone --depth 1 https://github.com/Neko-Void-Linux/dmemcg-booster-nk.git .
	cargo build --release --locked
}

do_install() {
	DESTDIR="${DESTDIR}" PREFIX=/usr ./install-runit.sh
}
