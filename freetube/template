# Template file for 'freetube'
pkgname=freetube
version=0.25.3beta
revision=1
archs="x86_64"
build_style=fetch
hostmakedepends="unzip"
depends="gtk+3 libnotify nss libXScrnSaver libXtst xdg-utils at-spi2-core
 libuuid libsecret libgbm libdrm mesa-dri libxkbcommon libXrandr
 libXdamage libXcomposite libXfixes libX11 libxcb pango cairo atk
 glib gdk-pixbuf nspr libgcc libstdc++ eudev-libudev alsa-lib"
short_desc="Private YouTube client without ads"
maintainer="CrowRei34 <root@localhost>"
license="AGPL-3.0-or-later"
homepage="https://freetubeapp.io/"
_release="0.25.3-beta"
_portable="freetube-${_release}-linux-x64-portable.zip"
distfiles="https://github.com/FreeTubeApp/FreeTube/releases/download/v${_release}/${_portable}
 https://raw.githubusercontent.com/FreeTubeApp/FreeTube/v${_release}/_icons/iconColor.png>freetube-icon.png
 https://raw.githubusercontent.com/FreeTubeApp/FreeTube/v${_release}/LICENSE>freetube-license"
checksum="e3a671357ac32edcd872c6ea3218c8921bd0fda7318706d8570ece44d2c1fcbf
 d597647db3ce73c0e3db9c1d2f54aca6c1527b201727d40780fee57af61f0f1c
 8486a10c4393cee1c25392769ddd3b2d6c242d6ec7928e1414efff7dfb2f07ef"
nostrip=yes
nodebug=yes
noshlibprovides=yes
noverifyrdeps=yes
nopie=yes

do_install() {
	local _archive="${XBPS_SRCDISTDIR}/${pkgname}-${version}/${_portable}"
	local _icon="${XBPS_SRCDISTDIR}/${pkgname}-${version}/freetube-icon.png"
	local _license="${XBPS_SRCDISTDIR}/${pkgname}-${version}/freetube-license"

	# Instalar el binario portable oficial sin depender de un paquete Debian.
	vmkdir opt/freetube
	unzip -q "${_archive}" -d "${DESTDIR}/opt/freetube"
	chmod 4755 "${DESTDIR}/opt/freetube/chrome-sandbox"

	# Crear los accesos de ejecución e integración de escritorio.
	vmkdir usr/bin
	ln -sf /opt/freetube/freetube "${DESTDIR}/usr/bin/freetube"
	vinstall "${_icon}" 644 usr/share/icons/hicolor/512x512/apps freetube.png
	vmkdir usr/share/applications
	cat > "${DESTDIR}/usr/share/applications/freetube.desktop" <<-EOF
	[Desktop Entry]
	Name=FreeTube
	Comment=Private YouTube client without ads
	Exec=/usr/bin/freetube %U
	Icon=freetube
	Terminal=false
	Type=Application
	Categories=AudioVideo;Video;Network;
	MimeType=x-scheme-handler/http;x-scheme-handler/https;
	EOF

	vlicense "${_license}"
}
