pkgname=stremio
version=4.4.168
revision=3
only_for_archs="x86_64"
short_desc="Freedom to Stream"
maintainer="JavierC"
depends="nodejs mpv qt5-declarative qt5-quickcontrols qt5-quickcontrols2 qt5-webchannel qt5-webengine rubberband uchardet fdk-aac libssl1.1"
hostmakedepends="tar xz wget patchelf"
license="MIT"
homepage="https://www.stremio.com/"
nostrip=yes

do_extract() {
	mkdir -p ${DESTDIR}
	wget -O ${XBPS_SRCDISTDIR}/${pkgname}-${version}/stremio_4.4.168-1_amd64.deb https://dl.strem.io/shell-linux/v4.4.168/stremio_4.4.168-1_amd64.deb
	ar x ${XBPS_SRCDISTDIR}/${pkgname}-${version}/stremio_4.4.168-1_amd64.deb
}

do_install() {
	tar xf data.tar.xz -C ${DESTDIR}

	for size in 24 32 64 128 256; do
		mkdir -p ${DESTDIR}/usr/share/icons/hicolor/${size}x${size}/apps
		mv ${DESTDIR}/opt/stremio/icons/smartcode-stremio_${size}.png ${DESTDIR}/usr/share/icons/hicolor/${size}x${size}/apps/smartcode-stremio.png 2>/dev/null || true
		mv ${DESTDIR}/opt/stremio/icons/smartcode-stremio-tray_${size}.png ${DESTDIR}/usr/share/icons/hicolor/${size}x${size}/apps/smartcode-stremio-tray.png 2>/dev/null || true
	done
	
	mkdir -p ${DESTDIR}/usr/share/applications
	mv ${DESTDIR}/opt/stremio/smartcode-stremio.desktop ${DESTDIR}/usr/share/applications/smartcode-stremio.desktop
	patchelf --replace-needed libmpv.so.1 libmpv.so.2 "${DESTDIR}/opt/stremio/stremio"
	mkdir -p ${DESTDIR}/usr/bin
	ln -sf /opt/stremio/stremio ${DESTDIR}/usr/bin/stremio
	mkdir -p ${DESTDIR}/usr/lib
	if [ -f /usr/lib/libmpv.so.2 ]; then
		ln -sf /usr/lib/libmpv.so.2 "${DESTDIR}/usr/lib/libmpv.so.1"
	fi
}
