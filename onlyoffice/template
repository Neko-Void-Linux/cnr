pkgname=onlyoffice
version=10.0.0
revision=3
archs="x86_64"
create_wrksrc=yes
nostrip=yes
nopie=yes
noshlibprovides=yes
noverifyrdeps=yes
hostmakedepends="bsdtar"
depends="gtk+3 nss nspr dbus alsa-lib libcups libnotify libXScrnSaver
 libXtst libXrandr libXcomposite libXdamage libXext libXfixes libxcb
 libxkbcommon libglvnd desktop-file-utils hicolor-icon-theme xdg-utils
 dejavu-fonts-ttf liberation-fonts-ttf font-crosextra-carlito-ttf"
short_desc="Office suite for documents, spreadsheets, presentations and PDF forms"
maintainer="ANOMALI0x00"
license="AGPL-3.0-or-later"
homepage="https://www.onlyoffice.com"
distfiles="https://download.onlyoffice.com/install/desktop/editors/linux/onlyoffice-desktopeditors_amd64.deb"
checksum=2190edb4022a2ac2f6eee0f78815520f0e4ece1e8a1097c645a6f9b225c8b59c

do_extract() {
	local _deb="${XBPS_SRCDISTDIR}/${pkgname}-${version}/onlyoffice-desktopeditors_amd64.deb"
	cd "${wrksrc}"
	bsdtar -xf "${_deb}"
	local _data
	_data=$(ls data.tar.* 2>/dev/null | head -n1)
	if [ -z "${_data}" ]; then
		msg_error "No data.tar.* inside .deb\n"
	fi
	bsdtar -xf "${_data}"
	rm -f data.tar.* control.tar.* debian-binary
}

do_install() {
	vmkdir opt
	vcopy opt/onlyoffice opt/

	chmod +x "${DESTDIR}/opt/onlyoffice/desktopeditors/DesktopEditors"
	chmod +x "${DESTDIR}/opt/onlyoffice/desktopeditors/editors_helper"

	if [ -f "${DESTDIR}/opt/onlyoffice/desktopeditors/chrome-sandbox" ]; then
		chmod 4755 "${DESTDIR}/opt/onlyoffice/desktopeditors/chrome-sandbox"
	fi

	vmkdir usr/bin
	vinstall usr/bin/onlyoffice-desktopeditors 755 usr/bin
	ln -sf onlyoffice-desktopeditors "${DESTDIR}/usr/bin/desktopeditors"

	vinstall usr/share/applications/onlyoffice-desktopeditors.desktop 644 usr/share/applications

	vmkdir usr/share/icons
	vcopy usr/share/icons/hicolor usr/share/icons/

	if [ -f opt/onlyoffice/desktopeditors/LICENSE.txt ]; then
		vlicense opt/onlyoffice/desktopeditors/LICENSE.txt
	fi
}
