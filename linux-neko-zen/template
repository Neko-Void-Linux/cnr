pkgname=linux-neko-zen
version=7.1
revision=4
short_desc="Custom Zen kernel 7.1 precompiled for Void Linux"
maintainer="JavierC"
license="GPL-2.0-only"
homepage="https://github.com/javiercplus/kernel-neko-void"
distfiles="https://github.com/javiercplus/kernel-neko-void/releases/download/7.1/zen-kernel-void-7.1.2-zen3-neko+.tar.gz"
checksum="aed4f860a4a80a38f13d5355c2d1219e5d39dbbaadd4ea90eca6e83045e77e47"
create_wrksrc=yes
triggers="kernel-hooks"
kernel_hooks_version="7.1.2-zen3-neko+"
do_install() {
    vmkdir boot
    vmkdir usr/lib/modules
    vmkdir usr/src
    cp -a boot/* ${DESTDIR}/boot/
    cp -a lib/modules/* ${DESTDIR}/usr/lib/modules/
    cp -a usr/src/* ${DESTDIR}/usr/src/
}