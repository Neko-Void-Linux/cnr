pkgname=aseprite
version=1.3.18.2
revision=1
build_style=cmake
hostmakedepends="pkg-config cmake ninja unzip"
makedepends="libX11-devel libXcursor-devel libXi-devel libXext-devel
 libXrandr-devel libglvnd-devel zlib-devel libpng-devel libcurl-devel
 giflib-devel libjpeg-turbo-devel tinyxml2-devel pixman-devel
 freetype-devel harfbuzz-devel libwebp-devel fontconfig-devel
 alsa-lib-devel"
short_desc="Animated sprite editor & pixel art tool"
maintainer="ANOMALI0x00 <ANOMALI0x00@users.noreply.github.com>"
license="custom:EULA"
homepage="https://www.aseprite.org/"
distfiles="https://github.com/aseprite/aseprite/releases/download/v${version}/Aseprite-v${version}-Source.zip
 https://github.com/aseprite/skia/releases/download/m124-08a5439a6b/Skia-Linux-Release-x64.zip>skia-m124.zip"
checksum="5729921c1b22f5ad0577a558c8ebf3f3d00a088d82972c45905954eda9c68ab1
 a327e89b244f24cecaa34eb37544bae00d447b96c583d26ed29d6a3ad2e8a8b8"

create_wrksrc=yes

configure_args="
 -DLAF_BACKEND=skia
 -DUSE_SHARED_CMARK=OFF
 -DUSE_SHARED_CURL=ON
 -DUSE_SHARED_GIFLIB=ON
 -DUSE_SHARED_ZLIB=ON
 -DUSE_SHARED_LIBPNG=ON
 -DUSE_SHARED_TINYXML=OFF
 -DUSE_SHARED_PIXMAN=ON
 -DUSE_SHARED_FREETYPE=ON
 -DUSE_SHARED_HARFBUZZ=ON
 -DENABLE_CCACHE=OFF
"

pre_configure() {
    configure_args+=" -DSKIA_DIR=${wrksrc}/skia"
    configure_args+=" -DSKIA_LIBRARY_DIR=${wrksrc}/skia/out/Release-x64"
    configure_args+=" -DSKIA_LIBRARY=${wrksrc}/skia/out/Release-x64/libskia.a"
}

post_extract() {
    mkdir -p ${wrksrc}/skia
    unzip -q ${XBPS_SRCDISTDIR}/${pkgname}-${version}/skia-m124.zip -d ${wrksrc}/skia
}

post_install() {
    vlicense EULA.txt

    vinstall src/desktop/linux/aseprite.desktop 644 usr/share/applications

    for size in 16 20 24 28 32 48 64 128 256; do
        if [ -f "data/icons/ase${size}.png" ]; then
            vinstall data/icons/ase${size}.png 644 usr/share/icons/hicolor/${size}x${size}/apps aseprite.png
        fi
    done
}
