# Template file for 'xwinwrap'
pkgname=xwinwrap-nk
version=1.0
revision=3
build_style=gnu-makefile
makedepends="libXrender-devel"
short_desc="X11 Window as background"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT"
homepage="https://github.com/javiercplus/xwinwrap"
distfiles="${homepage}/archive/${version}.tar.gz"
checksum=4c0c0214b7ee3ceb4611ea2d7aa2ff746f8ed995ecae7b8e2284396be7ce06e1

post_patch() {
	# Corregir la regla install del Makefile
	vsed -i Makefile \
		-e 's|/local||g' \
		-e 's|^install:.*|install: xwinwrap\n\tinstall -Dm755 xwinwrap $(DESTDIR)/usr/bin/xwinwrap|'
}

post_install() {
	head -23 < xwinwrap.c | tail -22 | cut -c 4- > LICENSE
	vlicense LICENSE
}