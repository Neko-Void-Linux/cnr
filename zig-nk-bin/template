# Template file for 'zig'
pkgname=zig-nk-bin
version=0.16.0
revision=1
archs="x86_64"
short_desc="Programming language designed for robustness, optimality, and clarity"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT"
homepage="https://ziglang.org"
distfiles="https://ziglang.org/download/0.16.0/zig-x86_64-linux-0.16.0.tar.xz"
checksum=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00
wrksrc="zig-linux-x86_64-${version}"
nopie=yes
nocross=yes

do_install() {
    vmkdir usr/lib/zig
    cp -a ${wrksrc}/* ${DESTDIR}/usr/lib/zig/

    vmkdir usr/bin
    ln -sf ../lib/zig/zig ${DESTDIR}/usr/bin/zig
}

post_install() {
    vlicense LICENSE
}