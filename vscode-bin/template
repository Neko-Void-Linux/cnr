pkgname=vscode-bin
version=1.95.3
revision=1
archs="x86_64"
create_wrksrc=yes
#repository="nonfree"
#restricted=yes
nostrip=yes
nopie=yes
noshlibprovides=yes
hostmakedepends="bsdtar"
depends="libXtst nss alsa-lib gtk+3 libsecret libnotify libXScrnSaver xdg-utils desktop-file-utils"
short_desc="Visual Studio Code (official Microsoft binary release)"
maintainer="ANOMALI0x00 <ANOMALI0x00@users.noreply.github.com>"
license="custom:Unfree"
homepage="https://code.visualstudio.com"
distfiles="https://update.code.visualstudio.com/${version}/linux-x64/stable>vscode-${version}.tar.gz"
checksum=881c6dce9f9b18bdeaa0020197501be3808c6e23c26baa0ba905b0bc84175b46

do_extract() {
	bsdtar -xf ${XBPS_SRCDISTDIR}/${pkgname}-${version}/vscode-${version}.tar.gz -C ${wrksrc} --strip-components=1
}

do_install() {
	vmkdir usr/lib/code
	vcopy "*" usr/lib/code/

	vmkdir usr/bin
	ln -sf /usr/lib/code/bin/code ${DESTDIR}/usr/bin/code

	vmkdir usr/share/applications
	cat <<-'EOF' > ${DESTDIR}/usr/share/applications/code.desktop
	[Desktop Entry]
	Name=Visual Studio Code
	Comment=Code Editing. Redefined.
	GenericName=Text Editor
	Exec=/usr/lib/code/bin/code --unity-launch %F
	Icon=vscode
	Type=Application
	StartupNotify=false
	StartupWMClass=Code
	Categories=Utility;TextEditor;Development;IDE;
	MimeType=text/plain;inode/directory;application/x-code-workspace;
	Actions=new-empty-window;
	Keywords=vscode;

	[Desktop Action new-empty-window]
	Name=New Empty Window
	Exec=/usr/lib/code/bin/code --new-window %F
	Icon=vscode
	EOF

	cat <<-'EOF' > ${DESTDIR}/usr/share/applications/code-url-handler.desktop
	[Desktop Entry]
	Name=Visual Studio Code - URL Handler
	Comment=Code Editing. Redefined.
	GenericName=Text Editor
	Exec=/usr/lib/code/bin/code --open-url %U
	Icon=vscode
	Type=Application
	NoDisplay=true
	StartupNotify=false
	StartupWMClass=Code
	Categories=Utility;TextEditor;Development;IDE;
	MimeType=x-scheme-handler/vscode;
	Keywords=vscode;
	EOF

	vmkdir usr/share/pixmaps
	ln -sf /usr/lib/code/resources/app/resources/linux/code.png ${DESTDIR}/usr/share/pixmaps/vscode.png
}
