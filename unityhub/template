# Template file for 'unityhub'
pkgname=unityhub
version=3.21.2
revision=1
archs="x86_64"
hostmakedepends="tar zstd xz"
depends="gtk+3 libnotify nss xdg-utils at-spi2-core libdrm mesa libxcb ca-certificates gnupg libXScrnSaver libXtst libuuid libsecret tar zip unzip alsa-lib desktop-file-utils glib"
short_desc="The Official Unity Hub"
maintainer="Javierc <javiercyt@atomicmail.io>"
license="custom:Unity Terms of Service"
homepage="https://unity.com/hub"
distfiles="https://github.com/Neko-Void-Linux/Neko-Wizard/releases/download/debs/UnityHubSetup-amd64.deb>unityhub-${version}.deb"
checksum=d3ee77a9fb40cdb5e2233b5db71471fa57dc433f7d3cb663a00396c7c6529413
nostrip=yes

do_extract() {
	local debfile="${XBPS_SRCDISTDIR}/${pkgname}-${version}/unityhub-${version}.deb"
	ar x "${debfile}"
	tar xf data.tar.*
}

do_install() {
	vmkdir ${DESTDIR}/usr/
        cp -rf usr/* ${DESTDIR}/usr/
}
