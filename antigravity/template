pkgname=antigravity
version=2.24.0
revision=2
archs="x86_64"
create_wrksrc=yes
restricted=yes
nostrip=yes
nopie=yes
noshlibprovides=yes
hostmakedepends="patchelf python3 tar"
depends="alsa-lib dbus gtk+3 libnotify nss nspr libsecret libXtst
 libXScrnSaver xdg-utils desktop-file-utils hicolor-icon-theme"
short_desc="Antigravity - Agentic Desktop Application by Google"
maintainer="ANOMALI0x00"
license="custom:Proprietary"
homepage="https://antigravity.google"
_buildid=5780333019398144
distfiles="https://storage.googleapis.com/antigravity-public/antigravity-hub/${version}-${_buildid}/linux-x64/Antigravity.tar.gz"
checksum=8808bf580033c5d1365142e1e66ff37474f04a5fa0d9fc24b7c24c8216acdcc6

do_install() {
	local _bin _src pkg_dir="usr/lib/${pkgname}"

	_bin=$(find . -maxdepth 3 -type f -name antigravity -print -quit)
	if [ -z "$_bin" ]; then
		msg_error "No se encontró el binario 'antigravity' en el tarball extraído.\n"
	fi
	_src=$(dirname "$_bin")
	_src=${_src#./}
	[ -z "$_src" ] && _src="."

	vmkdir "${pkg_dir}"
	if [ "$_src" = "." ]; then
		cp -a ./. "${DESTDIR}/${pkg_dir}/"
	else
		cp -a "${_src}/." "${DESTDIR}/${pkg_dir}/"
	fi

	chmod +x "${DESTDIR}/${pkg_dir}/antigravity"

	if [ -f "${DESTDIR}/${pkg_dir}/resources/bin/language_server" ]; then
		chmod +x "${DESTDIR}/${pkg_dir}/resources/bin/language_server"
	fi

	if [ -f "${DESTDIR}/${pkg_dir}/resources/bin/webm_encoder" ]; then
		chmod +x "${DESTDIR}/${pkg_dir}/resources/bin/webm_encoder"
		patchelf --set-interpreter /lib64/ld-linux-x86-64.so.2 \
			"${DESTDIR}/${pkg_dir}/resources/bin/webm_encoder"
	fi

	if [ -f "${DESTDIR}/${pkg_dir}/chrome-sandbox" ]; then
		chmod 4755 "${DESTDIR}/${pkg_dir}/chrome-sandbox"
	fi

	vmkdir usr/share/pixmaps
	if [ -f "${DESTDIR}/${pkg_dir}/resources/app.asar" ]; then
		python3 - "${DESTDIR}/${pkg_dir}/resources/app.asar" "${DESTDIR}/usr/share/pixmaps/antigravity.png" << 'EOF'
import sys, struct, json
asar_path, out_path = sys.argv[1], sys.argv[2]
with open(asar_path, "rb") as f:
    f.read(4)
    struct.unpack("<I", f.read(4))
    f.read(4)
    json_size = struct.unpack("<I", f.read(4))[0]
    header = json.loads(f.read(json_size).decode("utf-8"))
    entry = header["files"].get("icon.png")
    if entry:
        f.seek(16 + json_size + int(entry["offset"]))
        with open(out_path, "wb") as out:
            out.write(f.read(entry["size"]))
EOF
	fi

	if [ ! -s "${DESTDIR}/usr/share/pixmaps/antigravity.png" ] && [ -f "${FILESDIR}/antigravity.png" ]; then
		vinstall "${FILESDIR}/antigravity.png" 644 usr/share/pixmaps
	fi

	if [ -s "${DESTDIR}/usr/share/pixmaps/antigravity.png" ]; then
		vmkdir usr/share/icons/hicolor/512x512/apps
		ln -sf /usr/share/pixmaps/antigravity.png \
			"${DESTDIR}/usr/share/icons/hicolor/512x512/apps/antigravity.png"
	fi

	if [ -f "${FILESDIR}/antigravity.svg" ]; then
		vinstall "${FILESDIR}/antigravity.svg" 644 usr/share/icons/hicolor/scalable/apps
	fi

	vmkdir usr/bin
	cat > "${DESTDIR}/usr/bin/antigravity" << 'EOF'
#!/bin/sh
exec /usr/lib/antigravity/antigravity "$@"
EOF
	chmod 755 "${DESTDIR}/usr/bin/antigravity"

	vmkdir usr/share/applications
	cat > "${DESTDIR}/usr/share/applications/antigravity.desktop" << 'EOF'
[Desktop Entry]
Name=Antigravity
Comment=Antigravity - Agentic Desktop Application
GenericName=AI Agent IDE
Exec=antigravity %U
Icon=antigravity
Terminal=false
Type=Application
StartupNotify=true
StartupWMClass=Antigravity
Categories=Development;IDE;Utility;
MimeType=x-scheme-handler/antigravity;
Keywords=antigravity;ai;agent;ide;google;coding;
EOF
	chmod 644 "${DESTDIR}/usr/share/applications/antigravity.desktop"

	local _lic=""
	for lf in LICENSE LICENSE.txt LICENSE.md COPYING; do
		if [ -f "${_src}/${lf}" ]; then
			_lic="${_src}/${lf}"
			break
		fi
	done
	if [ -n "$_lic" ]; then
		vlicense "$_lic"
	fi

	if [ -f "${_src}/LICENSE.electron.txt" ]; then
		vlicense "${_src}/LICENSE.electron.txt"
	fi

	if [ -f "${_src}/LICENSES.chromium.html" ]; then
		vlicense "${_src}/LICENSES.chromium.html"
	fi
}
