pkgname=artcraft-launcher
version=0.4.1
revision=1
archs="x86_64"
wrksrc="artcraft-launcher-${version}-linux-x86_64"
depends="hicolor-icon-theme libxkbcommon ca-certificates"
short_desc="Install, update and launch the Craft App Suite"
maintainer="ANOMALI0x00"
license="MIT, Apache-2.0"
homepage="https://getartcraft.com/apps"
distfiles="https://github.com/storytold/craft-launcher/releases/download/v${version}/artcraft-launcher-${version}-linux-x86_64.tar.gz"
checksum=2a2ee51d69bdb8174a2a48f30297fdbfa460b6e8737c3566a1b6ec46f831fa40
nostrip=yes

do_install() {
	vbin bin/artcraft-launcher
	vinstall share/applications/ai.storyteller.artcraft-launcher.desktop 644 usr/share/applications
	vinstall share/metainfo/ai.storyteller.artcraft-launcher.metainfo.xml 644 usr/share/metainfo
	vmkdir usr/share
	vcopy share/icons usr/share
	vlicense share/doc/artcraft-launcher/LICENSE-MIT
	vlicense share/doc/artcraft-launcher/LICENSE-APACHE
	vdoc share/doc/artcraft-launcher/README.md
	vdoc share/doc/artcraft-launcher/ATTRIBUTION.md
	vdoc share/doc/artcraft-launcher/NOTICE
}
