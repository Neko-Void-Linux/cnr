# Template file for '3utools'
pkgname=3utools
version=9.03.003
revision=1
archs="x86_64"

depends="hicolor-icon-theme libglvnd usbmuxd usbutils psmisc"

hostmakedepends="binutils tar xz patchelf file"
short_desc="Apple device management and jailbreak tool"
maintainer="ANOMALI0x00 <ANOMALI0x00@users.noreply.github.com>"
license="custom:proprietary"
homepage="https://www.3u.com"

distfiles="https://dl.3u.com/update/v900/dl/linux/x64/com.3u.3utools_${version}_amd64.deb"
checksum=3431e97e5b2dde0c1f8365ef5e0c15d79a11572d58dc0236029777a76b596fef
nopie_files="/opt/apps/com.3u.3utools/libexec/QtWebEngineProcess"

do_extract() {
	ar x ${XBPS_SRCDISTDIR}/${pkgname}-${version}/com.3u.3utools_${version}_amd64.deb
	tar xf data.tar.xz
}

do_install() {
	vcopy opt .
	vinstall usr/share/applications/com.3u.3utools.desktop 644 \
		usr/share/applications
	vinstall usr/share/icons/hicolor/scalable/apps/com.3u.3utools.svg 644 \
		usr/share/icons/hicolor/scalable/apps
	vinstall ${FILESDIR}/38-3uTools.rules 644 usr/lib/udev/rules.d
}

post_install() {
	local appdir="${DESTDIR}/opt/apps/com.3u.3utools"
	local libdir="${appdir}/lib"
	local abspath="/opt/apps/com.3u.3utools/lib:/usr/lib:/lib"

	# 1. Arreglar todos los ELF ejecutables del paquete
	#    (3uTools, libexec/QtWebEngineProcess, etc.)
	find "$appdir" -type f -perm -u+x -exec sh -c '
		for f; do
			file -b "$f" | grep -q ELF || continue
			patchelf --set-interpreter /usr/lib/ld-linux-x86-64.so.2 "$f" 2>/dev/null || true
			for lib in $(patchelf --print-needed "$f" 2>/dev/null | grep "^\./lib/"); do
				patchelf --replace-needed "$lib" "$(basename "$lib")" "$f" 2>/dev/null || true
			done
			patchelf --force-rpath --set-rpath "'"$abspath"'" "$f" 2>/dev/null || true
		done
	' sh {} +

	# 2. Arreglar el RPATH de todas las librerías empaquetadas
	for so in "$libdir"/*.so*; do
		[ -f "$so" ] || continue
		patchelf --force-rpath --set-rpath "$abspath" "$so" 2>/dev/null || true
	done

	# 3. Eliminar libc y ld-linux empaquetados (causan el conflicto GLIBC_2.38)
	rm -f "$libdir/libc.so.6" "$libdir/ld-linux-x86-64.so.2"

	# 4. Mejorar el nombre visible en el menú
	sed -i 's/^Name=com\.3u\.3utools$/Name=3uTools/' \
		"${DESTDIR}/usr/share/applications/com.3u.3utools.desktop"
}
