# Template file for 'ly'
pkgname=ly
version=1.5.0.1
revision=15
hostmakedepends="pkg-config zig-nk"
makedepends="libxcb-devel pam-devel"
depends="brightnessctl xauth"
short_desc="Lightweight TUI display manager"
maintainer="Haris <plavpxl@proton.me>"
license="WTFPL"
homepage="https://codeberg.org/fairyglade/ly"
distfiles="https://github.com/javiercplus/ly-xbps/releases/download/1.5.0.1/ly-v1.5.0-rc1.tar.gz"
checksum=8dd5554b420598437b5456ff1f41d40bae93a6f59b5f39771498305b59b8ce37

conf_files="
 /etc/ly/config.ini
 /etc/pam.d/ly
 /etc/pam.d/ly-autologin
 /etc/sv/ly/conf
"

pre_build() {
    # workaround for Zig path resolution where an empty sysroot
    # causes lib paths (like /usr/lib) to lose leading slash
    if [ -z "$CROSS_BUILD" ]; then
        export XBPS_CROSS_BASE="/"
    fi
}

post_patch() {
    vsed -i build.zig -e '/zig-out\/bin\/ly/d'
    vsed -i build.zig -e '/b.installArtifact(exe);/i \    exe.pie = true;'
}

do_build() {
    zig build installexe -Ddest_directory=zig-out -Dinit_system=runit
}

do_install() {
    # Void requiere que el binario esté en /usr/bin. Usamos `vbin`
    # que crea las rutas necesarias e instala el ejecutable correctamente.
    if [ -f zig-out/usr/bin/ly ]; then
        vbin zig-out/usr/bin/ly
    elif [ -f zig-out/bin/ly ]; then
        vbin zig-out/bin/ly
    fi

    # Copiamos la configuración y el servicio runit (carpeta /etc)
    # Evitamos usar `cp -a zig-out/*` para no arrastrar basura como /run o /bin al paquete
    if [ -d zig-out/etc ]; then
        vmkdir etc
        cp -a zig-out/etc/* ${DESTDIR}/etc/
    fi
}

post_install() {
    vlicense license.md
}
