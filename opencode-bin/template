pkgname=opencode-bin
version=1.18.30
revision=1
archs="x86_64"
short_desc="The AI coding agent built for the terminal."
maintainer="Soanvig <soanvig@gmail.com>"
license="MIT"
homepage="https://opencode.ai"
distfiles="https://github.com/anomalyco/opencode/releases/download/v${version}/opencode-linux-x64.tar.gz>opencode-bin_${version}_x86_64.tar.gz"
checksum=55007246858165496ff85ba1c2b648f7421e8e2013bf4189a680c9ff8e699d17
hostmakedepends="tar"
depends="ripgrep"

do_extract() {
	tar -xf "${XBPS_SRCDISTDIR}/${pkgname}-${version}/opencode-bin_${version}_x86_64.tar.gz" -C "${wrksrc}"
}

do_install() {
	vmkdir usr/bin
	vinstall opencode 755 usr/bin/opencode
}
