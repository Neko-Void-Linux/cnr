pkgname=steam-nk
version=1.0.0.85
revision=9
archs="x86_64"
create_wrksrc=yes
short_desc="Digital distribution platform by Valve (sandboxed binary version)"
maintainer="Javiercplus"
license="custom:Valve-EULA"
homepage="https://store.steampowered.com/about/"
distfiles="https://codeberg.org/Neko-Void/STEAM-ALT-VOID/releases/download/deb-build/steam_latest.deb"
checksum=b44634a6a604ca7c8b23809d0f2a921a0348bb2081c8cb8944116d0799872b70

# binutils es necesario para el comando 'ar'
hostmakedepends="binutils tar xz"

depends="desktop-file-utils hicolor-icon-theme xdg-utils zenity bubblewrap
 libgcc-32bit libstdc++-32bit libdrm-32bit libglvnd-32bit libibus libibus-32bit vulkan-loader-32bit
 libopenal-32bit libXrandr-32bit libnm-32bit dbus-glib libXtst libdrm
 libpciaccess libxshmfence nss-32bit nss p11-kit p11-kit-32bit gtk+-32bit gdk-pixbuf-32bit libcurl
 gtk+-32bit libpipewire-32bit libva-32bit libvdpau-32bit libvdpau mesa-dri mesa-dri-32bit
 steam-udev-rules SDL2 SDL2-32bit libpulseaudio-32bit alsa-plugins-pulseaudio-32bit"

conflicts="steam"
provides="steam-${version}_${revision}"

do_extract() {
    ar x ${XBPS_SRCDISTDIR}/${pkgname}-${version}/steam_latest.deb
    tar xf data.tar.xz
}

do_install() {
    # 1. Instalamos la estructura principal en /usr/lib/steam
    vmkdir usr/lib/steam
    vcopy usr/lib/steam/* usr/lib/steam/

    # 2. Instalamos nuestro wrapper personalizado como el ejecutable principal
    vinstall ${FILESDIR}/steam-wrapper 755 usr/bin steam

    # 3. Archivos de escritorio, iconos y documentación
    vmkdir usr/share
    for dir in applications doc icons man metainfo pixmaps; do
        if [ -d usr/share/$dir ]; then
            vcopy usr/share/$dir usr/share/
        fi
    done

    # 5. Límite de archivos para Proton (eventfd workaround)
    vmkdir etc/security/limits.d
    echo "* soft nofile 1048576" > ${DESTDIR}/etc/security/limits.d/99-steam.conf
    echo "* hard nofile 1048576" >> ${DESTDIR}/etc/security/limits.d/99-steam.conf

    # 6. Garantizar la creación de /run/media en cada reinicio (tmpfiles)
    vmkdir usr/lib/tmpfiles.d
    echo "d /run/media 0755 root root -" > ${DESTDIR}/usr/lib/tmpfiles.d/steam-bin.conf

    # 7. Licencia
    vlicense usr/share/doc/steam-launcher/copyright
}
