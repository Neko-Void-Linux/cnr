# Template file for 'Neko-Wizard'
pkgname=Neko-Wizard
version=9.0.13
revision=5
build_style=meson
hostmakedepends="pkg-config meson ninja cmake"
makedepends="gtk4-devel"
short_desc="Wizard Post Install for NEKO VOID"
maintainer="JavierC"
license="WTFPL"
homepage="https://codeberg.org/javiercplus/Neko-Wizard"
distfiles="https://codeberg.org/javiercplus/Neko-Wizard/archive/${version}.tar.gz"
checksum="08f21482cbb6aa1130acc82c6379b4310eabe6560f027d2244d62382a9696b9e"

do_install() {
	# Crear todos los directorios base necesarios primero
	vmkdir usr/lib/Neko-Wizard
	vmkdir usr/bin
	vmkdir usr/share/applications

	# Instalar el binario compilado
	vcopy build/neko-store usr/lib/Neko-Wizard/neko-store
	chmod 755 "${DESTDIR}/usr/lib/Neko-Wizard/neko-store"

	# Copiar las carpetas de recursos y data
	vcopy resources usr/lib/Neko-Wizard/resources
	vcopy data usr/lib/Neko-Wizard/data

	# Enlace simbólico en /usr/bin
	ln -s ../lib/Neko-Wizard/neko-store "${DESTDIR}/usr/bin/neko-store"

	# Crear e instalar el archivo .desktop
	cat > "${DESTDIR}/usr/share/applications/neko-store.desktop" << EOF
[Desktop Entry]
Type=Application
Name=Neko Wizard
Comment=WIZARD for INSTALL Software and DRIVERS
Exec=neko-store
Icon=system-software-install
Categories=Utility;
Terminal=false
EOF
	chmod 644 "${DESTDIR}/usr/share/applications/neko-store.desktop"

	# Instalar licencia
	if [ -f LICENSE ]; then
		vlicense LICENSE
	fi
}
