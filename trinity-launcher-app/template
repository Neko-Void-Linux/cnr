pkgname=trinity-launcher-app
version=20261002
revision=1
archs="x86_64*"
create_wrksrc=yes
short_desc="Minecraft Bedrock launcher (Trinity), prebuilt AnyLinux bundle"
maintainer="Dicov <SrDicov@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/Trinity-LA/Trinity-Launcher"
makedepends="wget"
depends="hicolor-icon-theme util-linux"
nostrip=yes
noverifyrdeps=yes
noshlibprovides=yes
nodebug=yes

do_extract() {
	mkdir -p "${wrksrc}"
	cd "${wrksrc}"
	
	# GitHub sirve los assets sin bit de ejecucion.
	local f="${XBPS_SRCDISTDIR}/${pkgname}-${version}/Trinity_Launcher-x86_64.AppImage"
    wget -O $f https://github.com/Trinity-LA/Trinity-Launcher/releases/download/latest/Trinity_Launcher-x86_64.AppImage
	chmod +x "$f"
	"$f" --appimage-extract
}

do_install() {
	vmkdir usr/lib/trinity-launcher-ap
	vcopy squashfs-root/. usr/lib/trinity-launcher-ap
	vmkdir usr/bin
	ln -s /usr/lib/trinity-launcher-ap/AppRun "${DESTDIR}/usr/bin/trinity-launcher-ap"
	test -e "${DESTDIR}/usr/lib/trinity-launcher-ap/AppRun"
	test "$(readlink "${DESTDIR}/usr/bin/trinity-launcher-ap")" = \
		/usr/lib/trinity-launcher-ap/AppRun

	sed -i "s|^Exec=trinity$|Exec=trinity-launcher-ap|" \
		squashfs-root/com.trench.trinity.launcher.desktop

	vmkdir usr/share/applications
	vmkdir usr/share/icons/hicolor/scalable/apps
	vcopy squashfs-root/com.trench.trinity.launcher.desktop usr/share/applications
	vcopy squashfs-root/com.trench.trinity.launcher.svg \
		usr/share/icons/hicolor/scalable/apps
}
