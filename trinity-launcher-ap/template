# Z: mixto (glibc+musl). AppImage AnyLinux: trae glibc, Qt6, WebKit, Mesa y el
# engine de Bedrock dentro, asi que no depende de ninguna biblioteca del host.
# Probado en Alpine musl 1.2.6 sin glibc instalado: arranca y corre.
pkgname=trinity-launcher-ap
version=20261002
revision=1
# x86_64* y no x86_64: el case de pkgtarget.sh:32 compara la cadena del arch
# entero, asi que "x86_64" NO casa con "x86_64-musl" y el paquete seria
# glibc-only ("this package cannot be built for x86_64-musl").
archs="x86_64*"
create_wrksrc=yes
build_style=fetch
short_desc="Minecraft Bedrock launcher (Trinity), prebuilt AnyLinux bundle"
maintainer="Dicov <SrDicov@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/Trinity-LA/Trinity-Launcher"
# AnyLinux empaquetado con sharun 3.5.0: el runtime es un ELF static-pie que
# ejecuta su propio lib/ld-linux-x86-64.so.2 con --library-path, asi que el
# glibc del host no participa. Contiene glibc 2.44, 585 .so, Mesa y WebKit.
#
# version: upstream no versiona sus AppImages desde 2.6 (enero 2026) y el tag
# "latest" es un canal rodante que reconstruyen por cron (este asset se
# publico el 2026-08-02 pero se re-subio el 2026-10-02). Se usa la FECHA del
# asset porque ordena: un hash no, xbps creeria mas viejo un build nuevo y no
# actualizaria en silencio. Build de esta fecha: 2ba032c (sale en el log).
#
# Al actualizar, una linea cada cosa:
#   date -u -d "$(curl -sIL <distfiles> | grep -i ^last-modified | tail -1 | cut -d' ' -f2- | tr -d '\r')" +%Y%m%d
#   xgensum -i trinity-launcher-ap
# Si reconstruyen dos veces el mismo dia, revision+1. Si upstream reconstruye,
# este checksum deja de validar y el fallo sale como checksum mismatch al
# compilar: ruidoso, no silencioso.
distfiles="https://github.com/Trinity-LA/Trinity-Launcher/releases/download/latest/Trinity_Launcher-x86_64.AppImage"
checksum=bc046ee2b02e6a17e9a1752a102aedb8d781426829cb3f9b83691a11ed45f4c1
# hicolor-icon-theme no es una biblioteca: es el indice de iconos del sistema,
# para que el .svg de Trinity aparezca en el menu. util-linux aporta el unshare
# que usa bin/05-fix-namespaces.hook; sin el el bundle aborta al arrancar
# (medido: rc=134 y "Cannot find suitable binary to perform operation!"), sin
# mensaje util para el usuario. Es lo unico que se pide al host.
depends="hicolor-icon-theme util-linux"
nostrip=yes
# El bundle lleva 585 .so y un glibc 2.44 entero en
# /usr/lib/trinity-launcher-ap/lib.
# noverifyrdeps: salta el escaneo de NEEDED (common/hooks/pre-pkg/
# 04-generate-runtime-deps.sh hace return 0 antes de escanear). Sin el:
# "cannot guess required shlibs, aborting!", porque sus propias
# libc.so.6/libstdc++.so.6/Qt no las provee ningun paquete del host.
# noshlibprovides + nodebug: que el hook post-install
# (common/hooks/post-install/98-shlib-provides.sh) no registre 585 sonames
# del bundle como shlib-provides. Esto NO evita el error de arriba, son dos
# hooks distintos.
noverifyrdeps=yes
noshlibprovides=yes
nodebug=yes

do_extract() {
	mkdir -p "${wrksrc}"
	cd "${wrksrc}"
	# GitHub sirve los assets sin bit de ejecucion.
	local f="${XBPS_SRCDISTDIR}/${pkgname}-${version}/Trinity_Launcher-x86_64.AppImage"
	chmod +x "$f"
	"$f" --appimage-extract
}

do_install() {
	# El AppDir entero y solo dentro de DESTDIR, para que xbps-remove lo
	# borre completo. Nada de /usr/share/{alsa,pipewire,X11,glib-2.0} del
	# AppDir: es configuracion aislada a proposito y mezclarla con la del
	# host rompe el bundle (es lo que lo hace portable a musl).
	#
	# Rutas escritas a mano y no con ${d}: un symlink mal construido es
	# invisible hasta que lo ejecutas, que es tarde.
	vmkdir usr/lib/trinity-launcher-ap
	# El "/." final es obligatorio: sin el se pierde .env, que define
	# MCPELAUNCHER_DATA_DIR, WEBKIT_EXEC_PATH, GIO_MODULE_DIR, GDK_BACKEND
	# y friends. De paso preserva en una sola llamada los hardlinks entre
	# bin/, sharun/ y shared/.
	vcopy squashfs-root/. usr/lib/trinity-launcher-ap

	# El loader se localiza por /proc/self/exe, asi que el symlink basta y no
	# hace falta wrapper. Destino ABSOLUTO a proposito: con "../lib/..." hay
	# que acertar la aritmetica desde /usr/bin y el fallo sale como "no such
	# file" en el escritorio, no como error de build. Asi es imposible.
	# No se symlinkea /usr/bin/trinity porque ese nombre es del paquete
	# trinity de void (syscall fuzzer de kernelslacker).
	vmkdir usr/bin
	ln -s /usr/lib/trinity-launcher-ap/AppRun "${DESTDIR}/usr/bin/trinity-launcher-ap"
	# Un symlink roto no aborta el build, solo aparece como "no such file"
	# en el escritorio del usuario. Con destino absoluto no se puede hacer
	# "test -e" (apunta a /usr/lib, que aun no existe), asi que se compara
	# su contenido con la ruta real del payload: si el destino se escribe
	# mal, el build para aqui.
	test -e "${DESTDIR}/usr/lib/trinity-launcher-ap/AppRun"
	test "$(readlink "${DESTDIR}/usr/bin/trinity-launcher-ap")" = \
		/usr/lib/trinity-launcher-ap/AppRun

	# Upstream trae Exec=trinity, que ya no existe. El resto del .desktop se
	# conserva tal cual: su StartupWMClass=trinity.anylinux es el mismo que
	# fija el .env del bundle.
	sed -i "s|^Exec=trinity$|Exec=trinity-launcher-ap|" \
		squashfs-root/com.trench.trinity.launcher.desktop
	# vmkdir toma UN directorio y un modo opcional: dos rutas en la misma
	# llamada pasan la segunda como mode y install se queja.
	vmkdir usr/share/applications
	vmkdir usr/share/icons/hicolor/scalable/apps
	vcopy squashfs-root/com.trench.trinity.launcher.desktop usr/share/applications
	vcopy squashfs-root/com.trench.trinity.launcher.svg \
		usr/share/icons/hicolor/scalable/apps
}
