pkgname=vouru
version=3.3
revision=2
depends="xtools git curl bash xbps"
hostmakedepends="git"
makedepends="xtools git curl bash xbps"
short_desc="Void User Repository Helper - build/install packages from git and void-packages"
maintainer="JavierC"
license="BSD-3-Clause"
homepage="https://github.com/javiercplus/vouru"

do_build(){
	git clone https://github.com/Neko-Void-Linux/vouru.git .
}
do_install() {
	vbin vouru
	vlicense LICENSE
}
