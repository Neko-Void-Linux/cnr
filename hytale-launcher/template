# Template file for 'hytale-launcher'
pkgname=hytale-launcher
version=2026.08.06
revision=2
_build=68d97a2
archs="x86_64"
build_style=fetch
hostmakedepends="unzip"
# Dependencias segun los NEEDED reales del ELF (webkit2gtk-4.1 + soup3)
depends="gtk+3 libwebkit2gtk41 libsoup3 gdk-pixbuf glib
 glib-networking gsettings-desktop-schemas xdg-utils hicolor-icon-theme"
short_desc="Official Hytale launcher"
maintainer="Dicov <srdicov@gmail.com>"
license="custom:Proprietary"
homepage="https://hytale.com"
distfiles="https://launcher.hytale.com/builds/release/linux/amd64/hytale-launcher-latest.zip>hytale-launcher-${version}-${_build}.zip"
checksum=7aa3483bed31f2a49b83f10223b2ab19ba485adafc30267cdb108211f25a958b

# Evita que XBPS intente modificar el binario ya compilado
nostrip=yes
nopie=yes

do_install() {
	vextract "hytale-launcher-${version}-${_build}.zip"

	# 1. Núcleo de la aplicación bajo /opt
	vmkdir opt/hytale-launcher
	install -m 0755 hytale-launcher "${DESTDIR}/opt/hytale-launcher/hytale-launcher"

	# 2. Wrapper con la variable de entorno requerida
	vmkdir usr/bin
	cat > "${DESTDIR}/usr/bin/hytale-launcher" <<'EOF'
#!/bin/sh
export WEBKIT_DISABLE_COMPOSITING_MODE=1
exec /opt/hytale-launcher/hytale-launcher "$@"
EOF
	chmod 0755 "${DESTDIR}/usr/bin/hytale-launcher"

	# 3. Entrada de menú
	vmkdir usr/share/applications
	cat > "${DESTDIR}/usr/share/applications/hytale-launcher.desktop" <<'EOF'
[Desktop Entry]
Name=Hytale Launcher
Exec=hytale-launcher
Terminal=false
Type=Application
StartupWMClass=Hytale
Comment=Official Hytale launcher
Categories=Game;
Icon=hytale-launcher
EOF
}
