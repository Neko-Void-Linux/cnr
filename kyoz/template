pkgname=kyoz
version=2026.3
revision=4
hostmakedepends="zig-nk git"
makedepends="zig-nk git"
short_desc="Wrapper for xbps package manager"
maintainer="Javierc"
license="WTFPL"
homepage="https://github.com/Neko-Void-Linux/kyoz"

do_build() {
    git clone https://github.com/Neko-Void-Linux/kyoz.git .
    zig build-exe kyo.zig -mcpu=baseline -O ReleaseSafe
}

do_install() {
    vbin kyo
}
