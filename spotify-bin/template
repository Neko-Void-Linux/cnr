pkgname=spotify-bin
version=1.2.92.147
revision=1
archs="x86_64"
create_wrksrc=yes
repository="nonfree"
nostrip=yes
short_desc="Spotify digital music streaming service"
maintainer="ANOMALI0x00 <ANOMALI0x00@users.noreply.github.com>"
license="Proprietary"
homepage="https://www.spotify.com"

hostmakedepends="curl grep gawk tar"
depends="libcurl nss libXtst libXScrnSaver libxml2 libxslt libglvnd gtk+3
 alsa-lib desktop-file-utils hicolor-icon-theme xdg-utils libnotify libgcrypt"

do_fetch() {
	mkdir -p "${XBPS_SRCDISTDIR}/${pkgname}-${version}"
	cd "${XBPS_SRCDISTDIR}/${pkgname}-${version}"

	curl -sL -A "Mozilla/5.0" "https://repository.spotify.com/dists/stable/non-free/binary-amd64/Packages" -o Packages
	if [ ! -s Packages ]; then
		msg_error "No se pudo obtener la lista de paquetes del repositorio APT\n"
	fi

	local deb_file
	deb_file=$(grep -A 10 "Package: spotify-client" Packages | grep "Filename:" | head -1 | awk '{print $2}')
	if [ -z "$deb_file" ]; then
		msg_error "No se encontró el paquete en la lista de APT\n"
	fi

	curl -fL -A "Mozilla/5.0" -o spotify.deb "https://repository.spotify.com/${deb_file}"
	if [ ! -s spotify.deb ]; then
		msg_error "Falló la descarga del paquete .deb\n"
	fi
}

do_extract() {
	cd "${wrksrc}"
	local deb_file="${XBPS_SRCDISTDIR}/${pkgname}-${version}/spotify.deb"

	if [ ! -f "$deb_file" ]; then
		msg_error "No se encontró el archivo .deb\n"
	fi

	ar x "$deb_file"
	tar xf data.tar.*
}

do_install() {
	cd "${wrksrc}"

	# 1. Mover el directorio principal a /usr/lib/spotify
	vmkdir usr/lib
	if [ -d usr/share/spotify ]; then
		vmove usr/share/spotify usr/lib/spotify
	elif [ -d usr/lib/spotify ]; then
		vcopy usr/lib/spotify usr/lib
	fi

	# 2. Mover aplicaciones y metadata (.desktop)
	if [ -f "${DESTDIR}/usr/lib/spotify/spotify.desktop" ]; then
		vmove usr/lib/spotify/spotify.desktop usr/share/applications
	elif [ -f usr/share/applications/spotify.desktop ]; then
		vcopy usr/share/applications/spotify.desktop usr/share/applications
	fi

	# 3. Mover iconos a su ruta estándar
	if [ -d "${DESTDIR}/usr/lib/spotify/icons" ]; then
		vcopy usr/lib/spotify/icons/* usr/share/icons
		rm -rf "${DESTDIR}/usr/lib/spotify/icons"
	elif [ -d usr/share/icons ]; then
		vcopy usr/share/icons/* usr/share/icons
	fi

	# 4. Corregir ejecutable en el .desktop
	if [ -f "${DESTDIR}/usr/share/applications/spotify.desktop" ]; then
		vsed -i 's|Exec=.*|Exec=spotify %U|' "${DESTDIR}/usr/share/applications/spotify.desktop"
	fi

	# 5. Crear el symlink del binario principal en /usr/bin/spotify
	vmkdir usr/bin
	ln -sf /usr/lib/spotify/spotify "${DESTDIR}/usr/bin/spotify"
	chmod 755 "${DESTDIR}/usr/lib/spotify/spotify"
}
