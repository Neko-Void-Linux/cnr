pkgname=spotify-bin
version=1.2.92.147
revision=1
archs="x86_64"
create_wrksrc=yes
# repository="nonfree"
# restricted=yes
nostrip=yes
short_desc="Spotify digital music streaming service"
maintainer="ANOMALI0x00 <ANOMALI0x00@users.noreply.github.com>"
license="Proprietary"
homepage="https://www.spotify.com"

hostmakedepends="binutils tar xz curl grep gawk"
depends="libcurl nss libXtst libXScrnSaver libxml2 libxslt libglvnd gtk+3
 alsa-lib desktop-file-utils hicolor-icon-theme xdg-utils libnotify libgcrypt"

do_fetch() {
    msg_normal "=== OBTENIENDO SPOTIFY DESDE EL REPOSITORIO APT ===\n"

    mkdir -p "${XBPS_SRCDISTDIR}/${pkgname}-${version}"
    cd "${XBPS_SRCDISTDIR}/${pkgname}-${version}"

    msg_normal "Obteniendo lista de paquetes del repositorio APT...\n"
    curl -sL -A "Mozilla/5.0" "https://repository.spotify.com/dists/stable/non-free/binary-amd64/Packages" -o Packages

    if [ ! -s Packages ]; then
        msg_error "No se pudo obtener la lista de paquetes del repositorio APT\n"
    fi

    local deb_file
    deb_file=$(grep -A 10 "Package: spotify-client" Packages | grep "Filename:" | head -1 | awk '{print $2}')

    if [ -z "$deb_file" ]; then
        deb_file=$(grep "Filename:" Packages | head -1 | awk '{print $2}')
        if [ -z "$deb_file" ]; then
            msg_error "No se encontró ningún paquete en el repositorio APT\n"
        fi
    fi

    local full_url="https://repository.spotify.com/${deb_file}"

    msg_normal "Descargando spotify-client...\n"
    curl -fL -A "Mozilla/5.0" -o spotify.deb "${full_url}"

    if [ ! -s spotify.deb ]; then
        msg_error "Falló la descarga del archivo .deb\n"
    fi
}

do_extract() {
    cd "${wrksrc}"

    local deb_file="${XBPS_SRCDISTDIR}/${pkgname}-${version}/spotify.deb"

    if [ ! -f "$deb_file" ]; then
        msg_error "No se encontró el archivo .deb en: $deb_file\n"
    fi

    ar x "$deb_file"
    tar xf data.tar.*
}

do_install() {
    cd "${wrksrc}"

    msg_normal "=== INSTALANDO PAQUETE EN /opt/spotify ===\n"

    mkdir -p "${DESTDIR}/opt"
    if [ -d "usr/share/spotify" ]; then
        mv "usr/share/spotify" "${DESTDIR}/opt/spotify"
    fi

    if [ -d "${DESTDIR}/opt/spotify/icons" ]; then
        mkdir -p "${DESTDIR}/usr/share/icons"
        mv "${DESTDIR}/opt/spotify/icons/"* "${DESTDIR}/usr/share/icons/" 2>/dev/null || true
    fi

    mkdir -p "${DESTDIR}/usr/share/applications"
    if [ -f "${DESTDIR}/opt/spotify/spotify.desktop" ]; then
        mv "${DESTDIR}/opt/spotify/spotify.desktop" "${DESTDIR}/usr/share/applications/"
    fi

    if [ -f "${DESTDIR}/usr/share/applications/spotify.desktop" ]; then
        sed -i 's|Exec=.*|Exec=spotify %U|' "${DESTDIR}/usr/share/applications/spotify.desktop"
        sed -i 's|^Comment=.*|Comment=Cliente de reproducción de música en streaming|' "${DESTDIR}/usr/share/applications/spotify.desktop"
        sed -i 's|^GenericName=.*|GenericName=Reproductor de música Spotify|' "${DESTDIR}/usr/share/applications/spotify.desktop"
    fi

    mkdir -p "${DESTDIR}/usr/bin"
    ln -sf /opt/spotify/spotify "${DESTDIR}/usr/bin/spotify"

    chmod 755 "${DESTDIR}/opt/spotify/spotify" 2>/dev/null || true

    msg_normal "=== INSTALACIÓN COMPLETADA ===\n"
}
