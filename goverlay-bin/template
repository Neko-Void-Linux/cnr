# Template file for 'goverlay-bin' 
pkgname=goverlay-bin
version=1.9.0
revision=1
archs="x86_64"
create_wrksrc=yes
depends="MangoHud qt6-base-devel qt6-declarative-devel qt6-tools gamemode nerd-fonts"
short_desc="Modern Qt6 GUI application to configure MangoHud, vkBasalt, and more (Nightly)"
maintainer="Tu Nombre <tu@email.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/benjamimgois/Goverlay"
distfiles="https://github.com/benjamimgois/goverlay/releases/download/1.9.0/goverlay-1.9.0-x86_64.deb"
checksum=ad2aafae46f4787451d771db9e104bc70803a520d4a891b0493d06aec0d3c65c

# Conflictos por si también compilas la versión estable 'goverlay'
conflicts="goverlay>=0"
provides="goverlay-${version}_${revision}"

do_extract() {
    # Los paquetes .deb son archivos 'ar'. Primero extraemos su contenido.
    ar x ${XBPS_SRCDISTDIR}/goverlay_${version}_amd64.deb
    
    # Luego extraemos el archivo data.tar.* (puede ser .xz, .gz o .zst) que contiene los binarios
    tar xf data.tar.*
}

do_install() {
    # El archivo data.tar contiene la estructura estándar (usr/bin, usr/share, etc.)
    # Simplemente copiamos el directorio 'usr' al árbol de instalación del paquete
    vcopy usr /
}
