pkgname=mangowc-latest
version=0.18.2
revision=2
conf_files="/etc/mango/config.conf"
build_style=meson
hostmakedepends="pkg-config wayland-devel"
makedepends="cJSON-devel wlroots0.20-devel git pcre2-devel pango-devel scenefx-latest-devel cairo-devel"
depends="$(vopt_if xwayland xorg-server-xwayland)"
short_desc="Dwl-based wayland compositor using scenefx"
maintainer="JavierC <javiercyt@atomicmail.io>"
license="GPL-3.0-or-later"
homepage="https://github.com/mangowm/mango"
changelog="https://github.com/mangowm/mango/releases"

build_options="xwayland"
desc_option_xwayland="Enable Xwayland support"

do_fetch(){
git clone --depth 1 https://github.com/Neko-Void-Linux/mango.git "${pkgname}-${version}"
}
