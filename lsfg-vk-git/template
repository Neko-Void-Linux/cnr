pkgname=lsfg-vk-git
version=2026
revision=9
hostmakedepends="pkg-config"
makedepends="Vulkan-Headers clang base-devel qt6-base-devel git llvm curl cmake ninja qt6-declarative-devel"
depends="Vulkan-Headers Vulkan-Tools mesa qt6-base qt6-declarative"
short_desc="the most popular feature from the Windows-exclusive Lossless Scaling program to Linux."
maintainer="JavierC"
license="Creative Commons"
homepage="https://lsfg-vk.dev"

do_configure() {
	git clone --depth 1 https://git.lsfg-vk.dev/lsfg-vk.git .
}

do_build() {
	cd ${wrksrc}
	cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=ON \
    -DCMAKE_INSTALL_PREFIX=/usr/local \
    -DCMAKE_CXX_COMPILER=clang++ \
    -DCMAKE_CXX_COMPILER_AR=/usr/bin/llvm-ar \
    -DCMAKE_CXX_COMPILER_RANLIB=/usr/bin/llvm-ranlib \
    -DLSFGVK_BUILD_UI=ON
  cmake --build build
  vmkdir ${DESTDIR}/usr/local/lib64
  vmkdir ${DESTDIR}/usr/local/share/vulkan/implicit_layer.d
  vmkdir ${DESTDIR}/usr/local/bin
  vmkdir ${DESTDIR}/usr/local/share/icons/hicolor/256x256/apps
  vmkdir ${DESTDIR}/usr/local/share/applications
}

do_install() {
  vcopy build/lsfg-vk-layer/VkLayer_LSFGVK_frame_generation.json ${DESTDIR}/usr/local/lib64/liblsfg-vk-layer.so
  vcopy build/lsfg-vk-layer/VkLayer_LSFGVK_frame_generation.json ${DESTDIR}/usr/local/share/vulkan/implicit_layer.d/VkLayer_LSFGVK_frame_generation.json
  vbin build/lsfg-vk-cli/lsfg-vk-cli ${DESTDIR}/usr/local/bin/lsfg-vk-cli
  vbin build/lsfg-vk-ui/lsfg-vk-ui ${DESTDIR}/usr/local/bin/lsfg-vk-ui
  vcopy lsfg-vk-ui/resources/gay.pancake.lsfg-vk-ui.png ${DESTDIR}/usr/local/share/icons/hicolor/256x256/apps/gay.pancake.lsfg-vk-ui.png
  vcopy lsfg-vk-ui/resources/gay.pancake.lsfg-vk-ui.desktop ${DESTDIR}/usr/local/share/applications/gay.pancake.lsfg-vk-ui.desktop
}
